PORT=5000
NODE_ENV="development" # Set to "production" in Hostinger VPS
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173" # Change to "https://YOUR_DOMAIN.com" in production

# CLOUDINARY STORAGE (Required for Production Images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# DATABASE CONFIGURATION
# ----------------------
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production Deployment (PostgreSQL):
# 1. Ensure NODE_ENV="production"
# 2. Provide the PostgreSQL connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"
